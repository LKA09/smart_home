{
  "compilerOptions": {
    "target": "ES2019",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "node-fetch": [
        "./node_modules/@types/node-fetch/index.d.ts"
      ],
      "ws": [
        "./node_modules/@types/ws/index.d.ts"
      ],
      "axios": [
        "./node_modules/axios/index.d.ts"
      ],
      "@eneris/push-receiver": [
        "./node_modules/@eneris/push-receiver/dist/index.d.ts"
      ],
      "homebridge": [
        "./node_modules/homebridge/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
